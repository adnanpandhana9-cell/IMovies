# IMovies Frontend Environment Variables
# Base URL of the backend REST API (supports either VITE_API_BASE_URL or VITE_API_URL)
VITE_API_BASE_URL=http://localhost:5000/api
# In production, e.g. Vercel:
# VITE_API_BASE_URL=https://imovies-76zp.onrender.com/api
# VITE_API_URL=https://imovies-76zp.onrender.com/api

