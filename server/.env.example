# ========================================================
# IMovies Backend Environment Variables Template (.env.example)
# Copy this file to server/.env and fill in your values
# ========================================================

# Port the Express server listens on
PORT=5000

# Node environment mode: 'development' or 'production'
NODE_ENV=development

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@<cluster-host>/imovies?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/imovies?retryWrites=true&w=majority

# JWT secret for signing authentication tokens
# Replace with a cryptographically secure random string (minimum 32 characters)
JWT_SECRET=replace_with_a_random_secret

# Frontend client URL(s) for CORS authorization (comma-separated list for multiple origins)
# For local development:
CLIENT_URL=http://localhost:5173
# For production (e.g. on Render):
# CLIENT_URL=https://imovies-two-delta.vercel.app,https://imovies-9uwd3ztpc-adnanpandhana9-cells-projects.vercel.app

# Optional: Initial Administrator Bootstrap Credentials (used by npm run seed:admin)
# ADMIN_NAME=IMovies Admin
# ADMIN_EMAIL=admin@imovies.com
# ADMIN_PASSWORD=StrongAdminPassword123!
